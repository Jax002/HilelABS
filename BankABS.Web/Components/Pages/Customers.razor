@page "/customers"
@layout Layout.MainLayout
@using BankABS.Domain
@using BankABS.Services
@inject ICustomerService CustomerService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime

<MudCard>
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h5">Управление клиентами</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateNewCustomer">
                <MudIcon Icon="@Icons.Material.Filled.Add" /> Новый клиент
            </MudButton>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudTextField @bind-Value="searchString" Immediate="true" Placeholder="Поиск..." Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" />

        @if (loading)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="my-4" />
        }
        else
        {
            <MudTable Items="@filteredCustomers" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>ID</MudTh>
                    <MudTh>ФИО</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Телефон</MudTh>
                    <MudTh>ИНН</MudTh>
                    <MudTh>Статус</MudTh>
                    <MudTh>Действия</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="ID">@context.Id</MudTd>
                    <MudTd DataLabel="ФИО">@context.FullName</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                    <MudTd DataLabel="Телефон">@context.Phone</MudTd>
                    <MudTd DataLabel="ИНН">@context.TaxId</MudTd>
                    <MudTd DataLabel="Статус">
                        <MudText Color="@(context.IsActive ? Color.Success : Color.Error)">
                            @(context.IsActive ? "Активен" : "Неактивен")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Действия">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteCustomer(context))" Color="Color.Error" Size="Size.Small" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudCardContent>
</MudCard>

@code {
    private List<Customer> customers = new();
    private string searchString = string.Empty;
    private bool loading = true;

    private List<Customer> filteredCustomers => string.IsNullOrWhiteSpace(searchString)
            ? customers
            : customers.Where(c =>
                c.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                c.TaxId.Contains(searchString)).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadCustomers();
    }

    private async Task LoadCustomers()
    {
        loading = true;
        try
        {
            customers = (await CustomerService.GetAllCustomersAsync()).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки: {ex.Message}", Severity.Error);
        }
        loading = false;
    }

    private async Task CreateNewCustomer()
    {
        Snackbar.Add("Функция создания клиента будет добавлена позже", Severity.Info);
    }

    private async Task DeleteCustomer(Customer customer)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", $"Удалить клиента {customer.FullName}?");

        if (confirmed)
        {
            try
            {
                await CustomerService.DeleteCustomerAsync(customer.Id);
                await LoadCustomers();
                Snackbar.Add("Клиент удален", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Ошибка удаления: {ex.Message}", Severity.Error);
            }
        }
    }
}